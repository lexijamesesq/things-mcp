{
  "name": "things-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "build:native": "mkdir -p build && clang -fobjc-arc -Wall -Wextra -Werror -framework AppKit -framework ApplicationServices native/bridge.m -o build/things-bridge && clang -Wall -Wextra -Werror native/lock-run.c -o \"build/Things MCP\"",
    "build:worker": "cf build"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.14",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "cf": "1.0.0-beta.29",
    "miniflare": "5.20261110.0-beta",
    "rolldown": "1.2.18",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
